{
  "name": "terminal-restaurant-api",
  "version": "1.0.0",
  "description": "API del Terminal Punto de venta para Restaurantes, Propiedad de ISOTECH MÉXICO",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "lint:check": "eslint .",
    "lint": "eslint . --fix",
    "docker:db": "docker-compose up -d"
  },
  "author": "José David Ayala Franco",
  "license": "ISC",
  "dependencies": {
    "@sentry/node": "10.70.0",
    "base64-stream": "1.0.0",
    "bcrypt": "^6.0.0",
    "cors": "2.8.6",
    "express": "5.2.1",
    "jsonwebtoken": "9.0.3",
    "jwt-decode": "4.0.0",
    "lodash": "4.18.1",
    "moment": "2.30.1",
    "moment-timezone": "^0.6.3",
    "mongoose": "9.9.3",
    "mongoose-paginate-v2": "1.9.5",
    "morgan": "1.11.0",
    "nodemailer": "9.0.5",
    "pdfkit": "0.19.1",
    "serve-favicon": "2.5.1"
  },
  "devDependencies": {
    "eslint": "10.9.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-promise": "7.3.0",
    "husky": "=9",
    "lint-staged": ">=17.3.0",
    "nodemon": "3.1.14",
    "prettier": "3.9.6",
    "standard": "17.1.2"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.js": "eslint --cache --fix",
    "*.{js,css,md}": "prettier --write"
  },
  "overrides": {
    "brace-expansion": "^1.1.18"
  },
  "resolutions": {
    "brace-expansion": "^1.1.18"
  }
}
